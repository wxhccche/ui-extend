{
  "name": "@wxhccc/ui-extend",
  "version": "1.0.0-alpha.2",
  "description": "a library contains some componets base on ohter ui library.",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "pnpm run build:shared && pnpm run build:element && pnpm run build:antd-vue",
    "build:shared": "pnpm --filter @wxhccc/ue-shared run build",
    "build:element": "pnpm --filter @wxhccc/ue-element run build",
    "build:antd-vue": "pnpm --filter @wxhccc/ue-antd-vue run build",
    "dev:shared": "pnpm --filter @wxhccc/ue-shared run dev",
    "dev:element": "pnpm --filter @wxhccc/ue-element run dev",
    "dev:antd-vue": "pnpm --filter @wxhccc/ue-antd-vue run dev",
    "docs:dev": "pnpm --filter @wxhccc/ui-extend-docs run dev",
    "docs:build": "pnpm --filter @wxhccc/ui-extend-docs run build",
    "start": "pnpm run build && pnpm run docs:dev",
    "typecheck": "pnpm -r run typecheck",
    "typecheck:dist": "pnpm --filter @wxhccc/ui-extend-docs run typecheck:dist",
    "typecheck:dist:antd-vue": "pnpm --filter @wxhccc/ui-extend-docs run typecheck:dist:antd-vue",
    "typecheck:dist:element": "pnpm --filter @wxhccc/ui-extend-docs run typecheck:dist:element",
    "verify": "pnpm run build && pnpm run typecheck:dist",
    "release:plan": "node scripts/release.mjs",
    "release:bump": "node scripts/release.mjs --bump",
    "release:shared": "pnpm run build:shared && node scripts/release.mjs --publish --pkg @wxhccc/ue-shared",
    "release:element": "pnpm run build:shared && pnpm run build:element && pnpm run typecheck:dist:element && node scripts/release.mjs --publish --pkg @wxhccc/ue-element",
    "release:antd-vue": "pnpm run build:shared && pnpm run build:antd-vue && pnpm run typecheck:dist:antd-vue && node scripts/release.mjs --publish --pkg @wxhccc/ue-antd-vue",
    "release:dry": "pnpm run verify && node scripts/release.mjs --publish --dry-run",
    "release": "pnpm run verify && node scripts/release.mjs --publish",
    "lint": "eslint --ext .ts,.vue packages",
    "format": "prettier --write \"{packages,docs}/**/*.{ts,vue,json,md}\""
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/wxhccche/ui-extend.git"
  },
  "keywords": [
    "ui-extend",
    "vue",
    "components",
    "element-plus",
    "ant-design-vue",
    "utils"
  ],
  "author": "wxhccche",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wxhccche/ui-extend/issues"
  },
  "homepage": "https://wxhccche.github.io/ui-extend/",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^5.39.0",
    "@typescript-eslint/parser": "^5.39.0",
    "@vue/eslint-config-typescript": "^11.0.2",
    "eslint": "^8.25.0",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.6.0",
    "prettier": "^2.7.1",
    "typescript": "^6.0.3"
  }
}

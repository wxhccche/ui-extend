{
  "name": "@wxhccc/ui-extend-docs",
  "version": "1.0.0",
  "description": "a library contains some componets base on ohter ui library.",
  "private": true,
  "scripts": {
    "dev": "pnpm run dev:antd-vue",
    "dev:antd-vue": "vuepress dev -p 8081",
    "dev:element": "vuepress dev -p 8082",
    "build": "pnpm run build:antd-vue && pnpm run build:element",
    "build:antd-vue": "vuepress build",
    "build:element": "vuepress build -d .vuepress/dist/element",
    "docs:publish": "sh deploy.sh",
    "typecheck": "vue-tsc -p tsconfig.json",
    "typecheck:dist": "pnpm run typecheck:dist:antd-vue && pnpm run typecheck:dist:element",
    "typecheck:dist:antd-vue": "vue-tsc -p tsconfig.dist-smoke.antd-vue.json",
    "typecheck:dist:element": "vue-tsc -p tsconfig.dist-smoke.element.json"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/wxhccc/ui-extend.git"
  },
  "keywords": [
    "ui-extend",
    "vue",
    "components",
    "element-ui",
    "utils"
  ],
  "author": "wxhccc",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wxhccc/ui-extend/issues"
  },
  "homepage": "https://wxhccc.github.io/ui-extend/",
  "devDependencies": {
    "@ant-design/icons-vue": "^6.1.0",
    "@element-plus/icons-vue": "^2.0.10",
    "@types/lodash-es": "^4.17.6",
    "@types/markdown-it": "^12.2.3",
    "@types/minimist": "^1.2.2",
    "@vuepress/client": "2.0.0-beta.61",
    "@vuepress/plugin-container": "2.0.0-beta.61",
    "@vuepress/plugin-docsearch": "2.0.0-beta.61",
    "@vuepress/plugin-register-components": "2.0.0-beta.61",
    "@wxhccc/ue-antd-vue": "workspace:*",
    "@wxhccc/ue-element": "workspace:*",
    "@wxhccc/ue-shared": "workspace:*",
    "ant-design-vue": "^3.2.11",
    "element-plus": "^2.2.17",
    "lodash-es": "^4.17.21",
    "markdown-it": "^13.0.1",
    "markdown-it-container": "^3.0.0",
    "markdown-it-include": "^2.0.0",
    "minimist": "^1.2.6",
    "typescript": "^6.0.3",
    "vite": "^3.1.6",
    "vue": "^3.5.34",
    "vue-tsc": "^3.3.1",
    "vuepress": "2.0.0-beta.61",
    "vuepress-plugin-clean-urls": "^1.1.2"
  }
}

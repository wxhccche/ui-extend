{
  "name": "@wxhccc/ue-element",
  "version": "1.1.0",
  "description": "a library contains some componets base on element-plus",
  "type": "module",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.js"
    },
    "./style.css": "./dist/style.css",
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "vite build && vite build -c vite.umd.config.ts",
    "build:types": "vue-tsc -p tsconfig.build.json && node ../../scripts/fix-dts-paths.mjs dist \"@wxhccc/ue-element\"",
    "typecheck": "vue-tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/wxhccc/ui-extend.git"
  },
  "keywords": [
    "ui-extend",
    "vue",
    "components",
    "element-ui",
    "utils"
  ],
  "author": "wxhccc",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wxhccc/ui-extend/issues"
  },
  "homepage": "https://wxhccc.github.io/ui-extend/",
  "dependencies": {
    "@wxhccc/es-util": "^2.1.0",
    "@wxhccc/ue-shared": "workspace:^",
    "copy-to-clipboard": "^3.3.2",
    "cropperjs": "^1.5.3",
    "lodash-es": "^4.17.21"
  },
  "peerDependencies": {
    "@element-plus/icons-vue": "^2.0.6",
    "element-plus": "^2.2.11",
    "vue": "^3.2.40"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.0.10",
    "@types/lodash-es": "^4.17.6",
    "@vitejs/plugin-vue": "^3.1.2",
    "element-plus": "^2.2.17",
    "sass": "^1.55.0",
    "typescript": "^6.0.3",
    "vite": "^3.1.6",
    "vue": "^3.5.34",
    "vue-tsc": "^3.3.1"
  }
}

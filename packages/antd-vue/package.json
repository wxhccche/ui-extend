{
  "name": "@wxhccc/ue-antd-vue",
  "version": "1.3.0",
  "description": "a library contains some componets base on ohter ui library.",
  "type": "module",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.js"
    },
    "./style.css": "./dist/style.css",
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "import": "./dist/components/*/index.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "vite build && vite build -c vite.umd.config.ts",
    "build:types": "vue-tsc -p tsconfig.build.json && node ../../scripts/fix-dts-paths.mjs dist \"@wxhccc/ue-antd-vue\"",
    "typecheck": "vue-tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/wxhccche/ui-extend.git"
  },
  "keywords": [
    "ui-extend",
    "vue",
    "components",
    "ant-design-vue",
    "utils"
  ],
  "author": "wxhccche",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wxhccche/ui-extend/issues"
  },
  "homepage": "https://wxhccche.github.io/ui-extend/",
  "dependencies": {
    "@wxhccc/es-util": "^2.1.0",
    "@wxhccc/ue-shared": "workspace:^",
    "copy-to-clipboard": "^3.3.2",
    "cropperjs": "^1.5.3",
    "dayjs": "^1.11.5",
    "lodash-es": "^4.17.21",
    "vue-types": "^3.0.0"
  },
  "peerDependencies": {
    "@ant-design/icons-vue": "^6.1.0",
    "ant-design-vue": "^3.2.11",
    "vue": "^3.2.40"
  },
  "devDependencies": {
    "@ant-design/icons-vue": "^6.1.0",
    "@types/lodash-es": "^4.17.6",
    "@vitejs/plugin-vue": "^3.1.2",
    "ant-design-vue": "^3.2.11",
    "sass": "^1.55.0",
    "typescript": "^6.0.3",
    "vite": "^3.1.6",
    "vue": "^3.5.34",
    "vue-tsc": "^3.3.1"
  }
}

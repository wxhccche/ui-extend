{
  "name": "@wxhccc/ue-shared",
  "version": "1.1.0",
  "description": "ui-extend 的公共类型与工具（hooks、formatter、storage）",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.umd.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.umd.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "pnpm run build:js && pnpm run build:types",
    "build:js": "vite build",
    "build:types": "vue-tsc -p tsconfig.build.json && node ../../scripts/fix-dts-paths.mjs dist",
    "typecheck": "vue-tsc -p tsconfig.json"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/wxhccche/ui-extend.git"
  },
  "keywords": [
    "ui-extend",
    "vue",
    "utils",
    "shared"
  ],
  "author": "wxhccche",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wxhccche/ui-extend/issues"
  },
  "homepage": "https://wxhccche.github.io/ui-extend/",
  "dependencies": {
    "@wxhccc/es-util": "^2.1.0",
    "dayjs": "^1.11.5",
    "lodash-es": "^4.17.21",
    "store2": "^2.9.0"
  },
  "peerDependencies": {
    "vue": "^3.2.40"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.6",
    "@vitejs/plugin-vue": "^3.1.2",
    "sass": "^1.55.0",
    "typescript": "^6.0.3",
    "vite": "^3.1.6",
    "vue": "^3.5.34",
    "vue-tsc": "^3.3.1"
  }
}
